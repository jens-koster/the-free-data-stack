services:
  spark-master:
    image: tfds/spark-base:1.0.45
    container_name: spark-master
    hostname: spark-master
    networks:
      - tfds-network
    volumes:
      # let's make sure any data we want to store is preserved over container recreates
      # we put the catalog metadata here.
      - /opt/tfds/data/spark:/opt/tfds/data/spark

    environment:
        - SPARK_MODE=master
        # we need to make sure all nodes have the same hostname for the spark-master
        - SPARK_MASTER_HOST=${TFDS_SPARK_MASTER_HOST:-spark-master}
        - SPARK_MASTER_URL=${TFDS_SPARK_MASTER_URL:-spark://spark-master:7077}
        # this makes spark refer to the nodes by their hostname instead of the ip address
        - SPARK_LOCAL_HOSTNAME=${TFDS_SPARK_MASTER_HOST:-spark-master}
        # change default port from 8080, it's a popular one...
        # this port number must be the same inside the docker network and on the host for the webui to work.
        - SPARK_MASTER_WEBUI_PORT=8010
    ports:
      # spark service port, we need it to call spark from the notebooks in development
      - "127.0.0.1:7077:7077"
      # spark web ui
      - "127.0.0.1:8010:8010"

  spark-worker-1:
    image: tfds/spark-base:1.0.45
    container_name: spark-worker-1
    hostname: spark-worker-1
    networks:
      - tfds-network
    volumes:
      - /opt/tfds/data:/opt/tfds/data
    environment:
      - SPARK_MODE=worker
      - SPARK_MASTER_URL=${TFDS_SPARK_MASTER_URL:-spark://spark-master:7077}
      - SPARK_LOCAL_HOSTNAME=spark-worker-1
      - SPARK_WORKER_WEBUI_PORT=8011
    depends_on:
      - spark-master
    expose:
      - "8011"
    ports:
      - "127.0.0.1:8011:8011"


  spark-worker-2:
    image: tfds/spark-base:1.0.45
    container_name: spark-worker-2
    hostname: spark-worker-2
    networks:
      - tfds-network
    volumes:
      - /opt/tfds/data:/opt/tfds/data
    environment:
      - SPARK_MODE=worker
      - SPARK_MASTER_URL=${TFDS_SPARK_MASTER_URL:-spark://spark-master:7077}
      - SPARK_LOCAL_HOSTNAME=spark-worker-2
      - SPARK_WORKER_WEBUI_PORT=8012
    depends_on:
      - spark-master
    expose:
      - "8012"
    ports:
      - "127.0.0.1:8012:8012"

networks:
  tfds-network:
    name: tfds-network
    external: true
