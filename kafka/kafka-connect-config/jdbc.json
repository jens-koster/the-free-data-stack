{
  "name": "postgres-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "orders",
    "connection.url": "jdbc:postgresql://postgres:5432/jaffle_shop",
    "connection.user": "${POSTGRES_USER}",
    "connection.password": "${POSTGRES_PASSWORD}",
    "auto.create": "true",
    "insert.mode": "insert"
  }
}